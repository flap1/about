---
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allTopics = await getCollection("topics");
const topics = allTopics
  .filter((t) => !t.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear = new Map<number, typeof topics>();
for (const topic of topics) {
  const year = topic.data.pubDate.getFullYear();
  const existing = byYear.get(year);
  if (existing !== undefined) {
    existing.push(topic);
  } else {
    byYear.set(year, [topic]);
  }
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const allTags = [...new Set(topics.flatMap((t) => t.data.tags))].sort();
const dateLocale = lang === "ja" ? "ja-JP" : "en-US";
---

<div class="mx-auto max-w-2xl px-4 py-16">
  <header class="pb-8">
    <h1 class="text-3xl font-display tracking-tight">Topics</h1>
    <p class="mt-2 text-muted-foreground">
      {lang === 'ja'
        ? '技術、設計、日々の学びについて。'
        : 'Writing about technology, architecture, and the things I learn along the way.'}
    </p>
  </header>

  {allTags.length > 0 && (
    <div class="flex flex-wrap gap-2 pb-8 border-b border-border">
      {allTags.map((tag) => (
        <span class="px-2.5 py-0.5 text-xs rounded-full border border-border text-muted-foreground hover:text-foreground hover:border-ring transition-colors cursor-default">
          {tag}
        </span>
      ))}
    </div>
  )}

  {topics.length === 0 ? (
    <p class="py-12 text-center text-muted-foreground">
      {lang === 'ja' ? '準備中。' : 'No topics yet. Check back soon.'}
    </p>
  ) : (
    <div class="space-y-10 pt-4">
      {years.map((year) => {
        const yearTopics = byYear.get(year);
        return yearTopics !== undefined ? (
          <section>
            <h2 class="text-sm text-muted-foreground tracking-wider tabular-nums">{year}</h2>
            <ul class="mt-3 space-y-3">
              {yearTopics.map((topic) => (
                <li>
                  <a href={`/topics/${topic.id}`} class="group flex items-baseline justify-between gap-4">
                    <div class="min-w-0">
                      <span class="font-medium text-foreground group-hover:text-primary transition-colors">
                        {topic.data.title}
                      </span>
                      {topic.data.tags.length > 0 && (
                        <span class="ml-2 text-xs text-muted-foreground">
                          {topic.data.tags.join(' / ')}
                        </span>
                      )}
                    </div>
                    <span class="shrink-0 text-sm text-muted-foreground tabular-nums">
                      {topic.data.pubDate.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric' })}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null;
      })}
    </div>
  )}
</div>
