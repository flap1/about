---
---

<div id="search-container" class="hidden">
  <div
    id="search-backdrop"
    class="fixed inset-0 z-50 bg-black/50"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
  ></div>
  <div class="fixed inset-0 z-50 pointer-events-none">
    <div class="mx-auto max-w-xl mt-[10vh] px-4 pointer-events-auto">
      <div class="rounded-xl border border-border bg-card shadow-2xl overflow-hidden flex flex-col max-h-[75vh]">
        <div id="search" class="overflow-y-auto px-3 pt-2"></div>
        <div class="shrink-0 px-4 py-2 border-t border-border text-xs text-muted-foreground flex justify-between">
          <span>Press <kbd class="px-1.5 py-0.5 rounded border border-border bg-muted text-[0.7rem] font-mono">Esc</kbd> to close</span>
          <span><kbd class="px-1.5 py-0.5 rounded border border-border bg-muted text-[0.7rem] font-mono">Cmd</kbd> + <kbd class="px-1.5 py-0.5 rounded border border-border bg-muted text-[0.7rem] font-mono">K</kbd></span>
        </div>
      </div>
    </div>
  </div>
</div>

<button
  id="search-trigger"
  type="button"
  aria-label="Search (Cmd+K)"
  class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors"
>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8" />
    <line x1="21" y1="21" x2="16.65" y2="16.65" />
  </svg>
</button>

<script>
  function setupSearch() {
    const trigger = document.getElementById('search-trigger');
    const container = document.getElementById('search-container');
    const backdrop = document.getElementById('search-backdrop');
    let initialized = false;

    function open() {
      container?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      if (!initialized) {
        initialized = true;
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onerror = () => {
          const el = document.getElementById('search');
          if (el) el.innerHTML = '<p style="padding:1rem;opacity:0.6;font-size:0.875rem;">Search requires a build. Run pnpm build then pnpm preview.</p>';
        };
        script.onload = () => {
          // @ts-ignore
          new PagefindUI({
            element: '#search',
            showSubResults: true,
            showImages: false,
            translations: {
              placeholder: 'Search...',
              zero_results: 'No results for "[SEARCH_TERM]"',
            },
          });
          const input = document.querySelector<HTMLInputElement>('#search input');
          input?.focus();
        };
        document.head.appendChild(script);

        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(link);
      } else {
        const input = document.querySelector<HTMLInputElement>('#search input');
        input?.focus();
      }
    }

    function close() {
      container?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    trigger?.addEventListener('click', open);
    backdrop?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (container?.classList.contains('hidden')) {
          open();
        } else {
          close();
        }
      }
      if (e.key === 'Escape') close();
    });
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
