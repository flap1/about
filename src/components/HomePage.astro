---
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allTopics = await getCollection("topics");
const recentTopics = allTopics
  .filter((topic) => !topic.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const dateLocale = lang === "ja" ? "ja-JP" : "en-US";
const topicsBase = lang === "ja" ? "/ja/topics" : "/topics";
---

<div class="mx-auto max-w-2xl px-4 py-16">
  <section class="py-12">
    <p class="text-sm text-muted-foreground tracking-wider uppercase">Welcome to</p>
    <h1 class="mt-2 text-4xl font-display tracking-tight">
      flap1<span class="text-primary">.</span>com
    </h1>
    <p class="mt-4 text-lg text-muted-foreground leading-relaxed max-w-lg">
      {lang === 'ja'
        ? '開発者。構造化された知識、分散システム、自然界の静かなパターンに関心を持つ。'
        : 'Developer and builder. Interested in structured knowledge, distributed systems, and the quiet patterns of the natural world.'}
    </p>
    <p class="mt-2 text-muted-foreground">
      {lang === 'ja' ? '現在 ' : 'Currently building '}
      <a href="https://syntopic.io" class="text-accent hover:underline underline-offset-2" target="_blank" rel="noopener noreferrer">SynTopic</a>
      {lang === 'ja' ? ' を開発中。知識構造化プラットフォーム。' : ', a knowledge structuring platform.'}
    </p>
  </section>

  {recentTopics.length > 0 && (
    <section class="border-t border-border pt-8 pb-12">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-sm text-muted-foreground tracking-wider uppercase">Topics</h2>
        <a href={topicsBase} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          {lang === 'ja' ? '全て見る' : 'View all'} &rarr;
        </a>
      </div>
      <ul class="mt-4 space-y-3">
        {recentTopics.map((topic) => (
          <li>
            <a href={`/topics/${topic.id}`} class="group flex items-baseline justify-between gap-4">
              <span class="font-medium text-foreground group-hover:text-primary transition-colors">
                {topic.data.title}
              </span>
              <span class="shrink-0 text-sm text-muted-foreground tabular-nums">
                {topic.data.pubDate.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric' })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="border-t border-border pt-8">
    <h2 class="font-display text-sm text-muted-foreground tracking-wider uppercase">Elsewhere</h2>
    <ul class="mt-4 space-y-2">
      <li>
        <a href="https://github.com/flap1" class="text-muted-foreground hover:text-foreground transition-colors" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
    </ul>
  </section>
</div>
