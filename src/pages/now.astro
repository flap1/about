---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Now" description="What I'm focused on right now." lang="en">
  <article class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-display tracking-tight">Now</h1>
    <p class="mt-2 text-sm text-muted-foreground">Updated March 2026</p>

    <div class="prose mt-8">
      <h2>Building</h2>
      <p>
        <a href="https://syntopic.io">SynTopic</a> -- knowledge structuring platform.
        Turning research into a product that helps teams capture and reuse
        the reasoning behind their decisions.
      </p>

      <h2>Research</h2>
      <p>
        Ph.D. 1st year at the University of Tokyo.
        Knowledge engineering and model-based development for satellite systems.
      </p>

      <h2>Learning</h2>
      <ul>
        <li>Rust for systems programming</li>
        <li>Distributed systems design</li>
      </ul>

      <h2>Reading</h2>
      <ul>
        <li>Updating as I go.</li>
      </ul>
    </div>

    <p class="mt-12 text-sm text-muted-foreground">
      This is a <a href="https://nownownow.com/about" class="text-muted-foreground underline underline-offset-2 hover:text-foreground transition-colors" target="_blank" rel="noopener noreferrer">now page</a>.
    </p>
  </article>
</BaseLayout>
