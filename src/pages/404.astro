---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found" description="The page you are looking for does not exist." lang="en">
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center">
    <p class="text-8xl font-display text-muted-foreground">404</p>
    <h1 class="mt-4 text-2xl font-display text-foreground">Page not found</h1>
    <p class="mt-2 text-muted-foreground">The page you are looking for does not exist.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-accent-foreground font-medium hover:opacity-90 transition-opacity"
    >
      Back to home
    </a>
  </div>
</BaseLayout>
