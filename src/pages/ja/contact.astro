---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="連絡先。" lang="ja">
  <div class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-display tracking-tight">Contact</h1>

    <div class="prose mt-8">
      <p>
        GitHubが最も確実な連絡手段です。
      </p>

      <ul>
        <li><a href="https://github.com/flap1">GitHub</a></li>
      </ul>

      <p>
        SynTopicに関するお問い合わせは <a href="https://syntopic.io">syntopic.io</a> へ。
      </p>
    </div>
  </div>
</BaseLayout>
