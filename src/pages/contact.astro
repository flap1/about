    <h1 class="text-3xl font-display tracking-tight">Contact</h1>

    <div class="prose mt-8">
      <p>
        The best way to reach me is through GitHub.
      </p>

      <ul>
        <li><a href="https://github.com/flap1">GitHub</a></li>
      </ul>

      <p>
        For SynTopic-related inquiries, visit <a href="https://syntopic.io">syntopic.io</a>.
      </p>
    </div>
  </div>
</BaseLayout>
