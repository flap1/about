---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Uses" description="Tools, hardware, and software I use daily." lang="en">
  <article class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-display tracking-tight">Uses</h1>
    <p class="mt-2 text-muted-foreground">Tools, hardware, and software I use daily.</p>

    <div class="prose mt-8">
      <h2>Editor</h2>
      <ul>
        <li>Neovim + LazyVim</li>
        <li>VS Code + Claude Code</li>
        <li>Space Mono (editor font)</li>
      </ul>

      <h2>Terminal</h2>
      <ul>
        <li>WezTerm</li>
        <li>Zsh + Starship</li>
        <li>mise (runtime version manager)</li>
        <li>pnpm</li>
      </ul>

      <h2>Development</h2>
      <ul>
        <li>TypeScript / Rust / Python</li>
        <li>Astro, React</li>
        <li>Tailwind CSS v4</li>
        <li>Biome (linter/formatter)</li>
        <li>Playwright (testing)</li>
      </ul>

      <h2>Infrastructure</h2>
      <ul>
        <li>AWS (S3, CloudFront, Lambda, ECS)</li>
        <li>GitHub Actions</li>
        <li>Docker</li>
      </ul>

      <h2>Hardware</h2>
      <ul>
        <li>ThinkPad</li>
      </ul>

      <h2>Coffee</h2>
      <ul>
        <li>Hand drip</li>
      </ul>
    </div>
  </article>
</BaseLayout>
